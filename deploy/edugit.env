# /etc/edugit/edugit.env (chmod 640, root:edugit)
EDUGIT_ADDR=127.0.0.1:8080
EDUGIT_DATA_DIR=/var/lib/edugit
EDUGIT_PUBLIC_URL=https://git.example.edu
EDUGIT_SAML_IDP_METADATA=https://login.microsoftonline.com/<tenant>/federationmetadata/2007-06/federationmetadata.xml?appid=<app>
EDUGIT_STAFF_DOMAIN=example.edu
EDUGIT_STUDENT_DOMAIN=student.example.edu
EDUGIT_ADMIN_EMAILS=admin@example.edu
# Only because Caddy/nginx sits in front and sets X-Forwarded-For:
EDUGIT_TRUST_PROXY=true
